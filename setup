#!/usr/bin/env bash
set -euo pipefail

USAGE="Usage:
  setup <org> <app-id> <private-key.pem>   One-time setup of <org>: creates the public <org>/signup repo
                                           from this directory, turns on GitHub Pages, stores the
                                           Actions secrets, and saves the org's master key in
                                           ~/.config/gh_classroom/<org>.key."

if [ $# -ne 3 ]; then
  echo "$USAGE" >&2
  exit 1
fi

org=$1
app_id=$2
pem=$3
here=$(dirname "$0")
key_file=$HOME/.config/gh_classroom/$org.key

if [ ! -r "$pem" ]; then
  echo "Cannot read the App private key: $pem" >&2
  exit 1
fi

# The key file is written last, so it only exists once setup has finished. A new key would
# invalidate every link already handed out, so never replace it.
if [ -e "$key_file" ]; then
  echo "$org is already set up ($key_file exists)." >&2
  exit 1
fi

# The master key signs every assignment link.
key=$(openssl rand -hex 32)

if gh repo view "$org/signup" >/dev/null 2>&1; then
  echo "$org/signup already exists; not recreating it"
else
  gh repo create "$org/signup" --public --source "$here" --remote "$org" --push
fi

if gh api "repos/$org/signup/pages" >/dev/null 2>&1; then
  echo "GitHub Pages is already on"
elif ! gh api -X POST "repos/$org/signup/pages" -f 'source[branch]=main' -f 'source[path]=/' >/dev/null; then
  echo "Could not turn on GitHub Pages. If the error says Pages creation is disabled, allow it under" >&2
  echo "Org settings > Member privileges > Pages creation (Public), then run setup again." >&2
  exit 1
fi

printf %s "$key" | gh secret set MASTER_KEY --repo "$org/signup"
printf %s "$app_id" | gh secret set APP_ID --repo "$org/signup"
gh secret set APP_PRIVATE_KEY --repo "$org/signup" < "$pem"

# GitHub never shows a secret again, so this file is the only copy of the master key.
mkdir -p "$(dirname "$key_file")"
(umask 077; printf %s "$key" > "$key_file")

echo
echo "Done. $org is ready. You can now delete $pem; the App key is stored as an Actions secret."
echo "Make a student link with: ./classroom link $org <assignment>"
