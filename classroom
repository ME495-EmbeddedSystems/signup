#!/usr/bin/env bash
set -euo pipefail

USAGE="Usage:
  classroom link  <org> <assignment> [days]   Print the link students use to create their repo for
                                              <assignment>. The link expires after [days] days
                                              (default 30).
  classroom clone <org> <assignment> [dir]    Clone every repo named <assignment>-* into [dir]
                                              (default ./<assignment>). Repos that are already
                                              cloned are skipped."

if [ $# -lt 3 ]; then
  echo "$USAGE" >&2
  exit 1
fi

action=$1
org=$2
assignment=$3

# Also keeps the name safe to use in the link, the repo names and the jq filter below.
if [[ ! $assignment =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "The assignment name may only contain letters, digits, '_' and '-'." >&2
  exit 1
fi

case $action in
  link)
    days=${4:-30}

    # The org's MASTER_KEY, saved during setup (see the README).
    key_file=$HOME/.config/gh_classroom/$org.key
    if [ ! -r "$key_file" ]; then
      echo "No key for $org: expected it in $key_file (see the README setup)" >&2
      exit 1
    fi
    key=$(<"$key_file")
    if [ ${#key} -lt 32 ]; then
      echo "The key in $key_file is too short; it should be the org's 64-character MASTER_KEY." >&2
      exit 1
    fi

    expiry=$(date -u -d "+$days days" +%Y%m%d)

    # The first 32 hex characters of HMAC-SHA256(key, "<assignment>:<expiry>").
    secret=$(printf %s "$assignment:$expiry" | openssl dgst -sha256 -hmac "$key" | awk '{print substr($NF, 1, 32)}')

    echo "https://$org.github.io/signup/#$assignment.$expiry.$secret"
    echo "Valid through $expiry (UTC)" >&2
    ;;

  clone)
    dir=${4:-$assignment}

    repos=$(gh repo list "$org" --limit 1000 --json name --jq ".[].name | select(startswith(\"$assignment-\"))")
    if [ -z "$repos" ]; then
      echo "No repos in $org start with $assignment-" >&2
      exit 1
    fi

    mkdir -p "$dir"
    for repo in $repos; do
      if [ ! -d "$dir/$repo" ]; then
        git clone "git@github.com:$org/$repo.git" "$dir/$repo"
      fi
    done
    ;;

  *)
    echo "$USAGE" >&2
    exit 1
    ;;
esac
